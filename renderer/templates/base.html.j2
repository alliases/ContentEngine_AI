# renderer/templates/base.html.j2
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Slide Base</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');

    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
      background: #ffffff;
      -webkit-font-smoothing: antialiased;
    }

    .slide {
      width: 1080px;
      height: 1080px;
      box-sizing: border-box;
      padding: 80px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      page-break-after: always; /* Crucial for multi-page PDF */
      overflow: hidden;
    }

    .keyword {
      color: #2563eb; /* Brand primary color */
      font-weight: 800;
    }

    .slide-number {
      position: absolute;
      bottom: 40px;
      right: 40px;
      font-size: 24px;
      color: #9ca3af;
      font-weight: 600;
    }
  </style>
  {% block extra_css %}{% endblock %}
</head>
<body>
  {% block content %}{% endblock %}
  <script>
    // Invariant 3: Ensure rendering is fully complete and text is scaled
    document.fonts.ready.then(() => {
        const fitElements = document.querySelectorAll('.fit-text');

        fitElements.forEach(el => {
            const parent = el.closest('.slide');
            if (!parent) return;

            let minSize = 24;
            let maxSize = 80;
            const textLength = el.textContent.trim().length;

            // Aesthetic heuristic: scale max size based on character count
            // so paragraphs look like paragraphs and titles look like titles.
            if (textLength > 50 && textLength <= 150) {
                maxSize = 60;
            } else if (textLength > 150) {
                maxSize = 48;
            }

            let currentSize = maxSize;
            el.style.fontSize = currentSize + 'px';

            // Shrink to fit container bounds
            while (currentSize > minSize && (parent.scrollHeight > parent.clientHeight || parent.scrollWidth > parent.clientWidth)) {
                currentSize -= 2;
                el.style.fontSize = currentSize + 'px';
            }
        });

        // Yield to event loop to allow browser repaints
        requestAnimationFrame(() => {
            window.__RENDER_COMPLETE__ = true;
        });
    });
  </script>
</body>
</html>
